# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo (mobile app in Nelma-app/)
.expo/
.expo-export/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# generated native folders
Nelma-app/ios/
Nelma-app/android/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# macOS
.DS_Store
*.pem

# local env files (never commit secrets)
.env
.env*.local
.env.production

# typescript
*.tsbuildinfo

# local databases
*.db

# Python (backend/)
__pycache__/
.pytest_cache/
.ruff_cache/
.venv/
*.egg-info/

# Admin build output
admin/.output/
admin/.nitro/
admin/.tanstack/

# App builds are published as GitHub release files, not committed (they exceed GitHub's 100 MB limit)
*.apk
*.aab

# Tool output
output/
.playwright-cli/
