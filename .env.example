# Server settings for the Contabo Docker deployment (see DEPLOY.md).
#
# On the server: cp .env.example .env, fill it in, then chmod 600 .env.
# .env is git-ignored. Never commit real values.
#
# This file is NOT used by Render (Render keeps its own environment variables) or by local
# development (backend/.env and admin/.env).
#
# Values containing a "$" must be wrapped in single quotes, e.g. SMTP_PASSWORD='pa$$word'.

# --- Domains (used by Nginx, Let's Encrypt and the deploy health check) ---
API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com

# --- Admin dashboard build settings (public, baked into the browser bundle) ---
# Never put secrets in VITE_ variables.
VITE_API_URL=https://api.example.com/api/v1
VITE_DATA_MODE=api

# --- Backend (FastAPI) runtime settings ---
APP_ENV=production
DEBUG=false

# PostgreSQL. You can keep using the same Supabase database as Render (session pooler,
# with sslmode=require), or point at your own PostgreSQL server.
DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Each running color (blue and green) opens its own pool, so the total is about double.
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2

# Generate each with: openssl rand -hex 32
# Reuse Render's values if both deployments share one database and users should stay signed in.
JWT_SECRET_KEY=
INTERNAL_ADMIN_TOKEN=

# Browser origins allowed to call the API: the admin dashboard and any public website.
CORS_ORIGINS=https://admin.example.com

PAYMENT_PROVIDER=cash
RATE_LIMIT_ENABLED=true
# Nginx sets X-Forwarded-For, so the API sees real client IPs.
TRUST_PROXY_HEADERS=true

# Password-reset delivery (email + SMS). Production requires smtp_twilio.
NOTIFICATION_PROVIDER=smtp_twilio
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use either an E.164 sender number or a Messaging Service SID.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Push notifications through Expo.
EXPO_PUSH_ENABLED=true
EXPO_PUSH_ACCESS_TOKEN=

DELIVERY_CODE_REQUIRED=true

# Product pictures (Supabase Storage). Leave empty to only allow pasted https:// links.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PRODUCT_IMAGE_BUCKET=product-images
