# The NELMA API: the Contact Us and Order Now forms send to it, and prices and areas come from it.
# Leave empty to use https://nelma-gts5.onrender.com/api/v1. Add this website's address to the backend's CORS_ORIGINS.
VITE_API_URL=

# Where the "Download App" buttons send people. Leave empty to use the default:
#   https://github.com/Jacksonnavigator/Nelma/releases/latest/download/nelma.apk
# (the nelma.apk file attached to the newest GitHub release).
# Once the app is on the Play Store, set:
#   https://play.google.com/store/apps/details?id=com.nelma.drinkingwater
VITE_ANDROID_DOWNLOAD_URL=

# App Store link; leave empty to hide the App Store button.
VITE_IOS_DOWNLOAD_URL=