APP_NAME=NELMA API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=sqlite:///./nelma.db
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2

JWT_SECRET_KEY=development-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=15

FIRST_PURCHASE_PRICE=18000
REFILL_PRICE=4000
CURRENCY=TZS
MAX_ORDER_QUANTITY=50

PAYMENT_PROVIDER=development
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_MERCHANT_ID=
PAYMENT_PROVIDER_WEBHOOK_SECRET=
DEVELOPMENT_WEBHOOK_SECRET=development-webhook-secret

# Development automatically allows localhost/loopback and private-LAN Expo origins.
# Optional additional origins (CSV or JSON list). Production requires explicit origins.
CORS_ORIGINS=
RATE_LIMIT_ENABLED=true
TRUST_PROXY_HEADERS=false
INTERNAL_ADMIN_TOKEN=development-internal-admin-token
# For a cash-only production deployment, set PAYMENT_PROVIDER=cash.
# Both reset channels: use smtp_twilio after filling the values below.
NOTIFICATION_PROVIDER=development
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# starttls (usually 587) or ssl (usually 465); TLS is always required.
SMTP_SECURITY=starttls
NOTIFICATION_TIMEOUT_SECONDS=10
# Push alerts through Expo (new assignments, delivery updates). The mobile build also needs an EAS project id.
EXPO_PUSH_ENABLED=false
EXPO_PUSH_ACCESS_TOKEN=
# Drivers must enter the customer's 4-digit code (or give a reason) to complete a delivery.
DELIVERY_CODE_REQUIRED=true
# Deliveries the customer never confirms are closed automatically after this many hours.
AUTO_RECEIVE_HOURS=24
# Assignments a driver has not accepted after this many minutes are flagged in the admin Operations view.
ASSIGNMENT_ACCEPT_MINUTES=30
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use either an E.164 sender or a Messaging Service SID.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
