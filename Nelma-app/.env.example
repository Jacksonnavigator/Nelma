# Real accounts require API mode and a reachable FastAPI base URL.
EXPO_PUBLIC_USE_MOCKS=false
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Local desktop: http://127.0.0.1:8000/api/v1
# Android emulator: http://10.0.2.2:8000/api/v1
# Physical device: http://YOUR_COMPUTER_LAN_IP:8000/api/v1
# Frontend-only demos: explicitly set EXPO_PUBLIC_USE_MOCKS=true.

# Support phone and email come from the dashboard's System Settings.
# Optional: a different WhatsApp number for the Contact screen (defaults to the support phone).
EXPO_PUBLIC_SUPPORT_WHATSAPP=
