# Local FastAPI backend (include /api/v1).
VITE_API_URL=http://127.0.0.1:8000/api/v1

# api persists changes in the backend; mock uses development demo data.
VITE_DATA_MODE=api

# Production must use HTTPS, or a same-origin path behind a reviewed backend proxy:
# VITE_API_URL=https://your-api.example/api/v1
# VITE_API_URL=/api/v1
# Only VITE_API_URL and VITE_DATA_MODE are allowed in release builds.
# NEVER put passwords, signing keys or other secrets in VITE_* variables.
# Mock production bundles require NELMA_ALLOW_DEMO_BUILD=true, for demos only.
